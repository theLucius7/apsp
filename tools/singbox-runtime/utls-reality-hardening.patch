+	data, err := io.ReadAll(client)
+	if err != nil || string(data) != "late reply" {
+		t.Fatalf("half-close must reach a wrapped target, got %q, %v", data, err)
+	}
+}
+
+func TestRealityRelayForwardsTargetRSTThroughWrappers(t *testing.T) {
+	client := startRelayWith(t, func(target net.Conn) {
+		target.Read(make([]byte, 64))
+		target.(*net.TCPConn).SetLinger(0)
+		target.Close()
+	}, wrap)
+	client.Write([]byte("GET / HTTP/1.1\r\n\r\n"))
+	if _, err := io.ReadAll(client); !errors.Is(err, syscall.ECONNRESET) {
+		t.Fatalf("expected the target's reset to reach a wrapped client, got %v", err)
+	}
+}
+
+// A closed target answers further data with a reset; the client must see that
+// reset too instead of a connection that silently swallows its bytes.
+func TestRealityRelayMirrorsResetAfterTargetFIN(t *testing.T) {
+	client := startRelay(t, func(target net.Conn) {
+		target.Read(make([]byte, 64))
+		target.Write([]byte("bye"))
+		target.Close()
+	})
+	client.Write([]byte("GET / HTTP/1.1\r\n\r\n"))
+	data, err := io.ReadAll(client)
+	if err != nil || string(data) != "bye" {
+		t.Fatalf("expected the reply and the target's FIN, got %q, %v", data, err)
+	}
+	client.Write([]byte("more"))
+	// After a FIN, reads keep returning EOF even once a reset has arrived; the
+	// reset shows up as a failed write.
+	start := time.Now()
+	for time.Since(start) < 5*time.Second {
+		time.Sleep(50 * time.Millisecond)
+		if _, err = client.Write([]byte("x")); errors.Is(err, syscall.ECONNRESET) || errors.Is(err, syscall.EPIPE) {
+			if time.Since(start) > realityRelayLinger/2 {
+				t.Fatalf("reset came from the linger timeout, not from the target")
+			}
+			return
+		}
+	}
+	t.Fatalf("data after the target's FIN must end in a reset, last error %v", err)
+}
+
+// A client that resets must reset the target as well, even when the reset is
+// consumed by the relay's blocked write towards the client and the upload
+// direction only reads EOF.
+func TestRealityRelayForwardsClientRST(t *testing.T) {
+	result := make(chan error, 1)
+	client := startRelay(t, func(target net.Conn) {
+		defer target.Close()
+		target.Read(make([]byte, 64))
+		// Fill every buffer up to the client, which never reads, then only read.
+		target.SetWriteDeadline(time.Now().Add(300 * time.Millisecond))
+		target.Write(make([]byte, 64<<20))
+		target.SetReadDeadline(time.Now().Add(5 * time.Second))
+		_, err := io.Copy(io.Discard, target)
+		result <- err
+	})
+	client.Write([]byte("GET / HTTP/1.1\r\n\r\n"))
+	time.Sleep(600 * time.Millisecond)
+	client.SetLinger(0)
+	client.Close()
+	if err := <-result; !errors.Is(err, syscall.ECONNRESET) {
+		t.Fatalf("expected the client's reset to reach the target, got %v", err)
+	}
+}
+
+// Once the target has half-closed and keeps reading, client data must flow on
+// without waiting for a reset that never comes.
+func TestRealityRelayUploadDoesNotStallAfterTargetHalfClose(t *testing.T) {
+	received := make(chan string, 1)
+	client := startRelay(t, func(target net.Conn) {
+		defer target.Close()
+		target.Read(make([]byte, 64))
+		target.Write([]byte("reply"))
+		target.(*net.TCPConn).CloseWrite()
+		data, _ := io.ReadAll(target)
+		received <- string(data)
+	})
+	client.Write([]byte("GET / HTTP/1.1\r\n\r\n"))
+	if data, err := io.ReadAll(client); err != nil || string(data) != "reply" {
+		t.Fatalf("expected the reply and a half-close, got %q, %v", data, err)
+	}
+	start := time.Now()
+	for _, chunk := range []string{"a", "b", "c", "d"} {
+		client.Write([]byte(chunk))
+		time.Sleep(20 * time.Millisecond)
+	}
+	client.CloseWrite()
+	select {
+	case data := <-received:
+		if data != "abcd" || time.Since(start) > time.Second {
+			t.Fatalf("upload after the target's half-close took %v and delivered %q", time.Since(start), data)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("upload after the target's half-close stalled")
+	}
+}
diff --git a/reality_apsp_unix.go b/reality_apsp_unix.go
new file mode 100644
index 0000000..c94346f
--- /dev/null
+++ b/reality_apsp_unix.go
@@ -0,0 +1,20 @@
+//go:build unix && !linux
+
+package tls
+
+import "syscall"
+
+// realitySocketState reads the socket's pending error. Without tcp_info a
+// normal close is not visible here, so only a reset is reported.
+func realitySocketState(control syscall.RawConn) (closed, reset, known bool) {
+	var value int
+	var err error
+	if control.Control(func(fd uintptr) {
+		value, err = syscall.GetsockoptInt(int(fd), syscall.SOL_SOCKET, syscall.SO_ERROR)
+	}) != nil || err != nil {
+		return false, false, false
+	}
+	errno := syscall.Errno(value)
+	reset = errno == syscall.ECONNRESET || errno == syscall.EPIPE
+	return reset, reset, true
+}
