new file mode 100644
index 0000000..56e5721
--- /dev/null
+++ b/reality_apsp_windows.go
@@ -0,0 +1,14 @@
+//go:build windows
+
+package tls
+
+import (
+	"errors"
+	"syscall"
+)
+
+// Windows reports a peer reset as WSAECONNRESET and a local abort as
+// WSAECONNABORTED rather than the POSIX errno values.
+func realityPlatformReset(err error) bool {
+	return errors.Is(err, syscall.Errno(10054)) || errors.Is(err, syscall.Errno(10053))
+}
