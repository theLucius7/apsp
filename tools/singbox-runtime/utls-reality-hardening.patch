+//go:build !unix
+
+package tls
+
+import "syscall"
+
+// realitySocketReset is not implemented here; the relay then keeps forwarding
+// after the target's close, as it did before.
+func realitySocketReset(syscall.RawConn) (reset bool, known bool) {
+	return false, false
+}
