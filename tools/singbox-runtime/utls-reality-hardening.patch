diff --git a/reality_apsp.go b/reality_apsp.go
new file mode 100644
index 0000000..5af62f2
--- /dev/null
+++ b/reality_apsp.go
@@ -0,0 +1,232 @@
+// Additions made by the Apsp runtime build. They keep a REALITY inbound
+// indistinguishable from its target at the points an active prober or a
+// passive observer can measure. Ported in behaviour from XTLS/REALITY; see
+// tools/singbox-runtime/README.md in the Apsp repository.
+
+package tls
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+const (
+	// realityRelayLinger bounds how long a silent client can pin a relay after
+	// the target has finished. A real server has fully closed by this point.
+	realityRelayLinger = 30 * time.Second
+
+	realityPostHandshakeRefresh = 6 * time.Hour
+	realityPostHandshakeRetry   = 5 * time.Minute
+	realityPostHandshakeWait    = 5 * time.Second
+	realityPostHandshakeDial    = 10 * time.Second
+	realityPostHandshakeMax     = 8
+
+	// A sealed record is header + inner type + padding + AEAD tag.
+	realityPostHandshakeMinLen = recordHeaderLen + 1 + 16
+)
+
+type realityCloseWriter interface {
+	CloseWrite() error
+}
+
+type realityLinger interface {
+	SetLinger(sec int) error
+}
+
+// realityCloseWrite forwards the end of one relayed direction. Half-close must
+// survive: the opposite direction may still be delivering the target's reply.
+func realityCloseWrite(conn net.Conn) {
+	if closer, ok := conn.(realityCloseWriter); ok {
+		if closer.CloseWrite() == nil {
+			return
+		}
+	}
+	conn.Close()
+}
+
+// realityFinishClient ends the client side the way the target ended its side,
+// so close type and timing come from the target rather than from this process.
+func realityFinishClient(client net.Conn, err error) {
+	if errors.Is(err, syscall.ECONNRESET) {
+		realityResetClient(client)
+		return
+	}
+	realityCloseWrite(client)
+	client.SetReadDeadline(time.Now().Add(realityRelayLinger))
+}
+
+// realityAbortClient handles a target that ended before sending anything.
+func realityAbortClient(client net.Conn, err error) {
+	if errors.Is(err, syscall.ECONNRESET) {
+		realityResetClient(client)
+		return
+	}
+	client.Close()
+}
+
+func realityResetClient(client net.Conn) {
+	if linger, ok := client.(realityLinger); ok {
+		linger.SetLinger(0)
+	}
+	client.Close()
+}
+
+// realityPostHandshakeEntry holds the record lengths a target sends right after
+// the client's Finished, for one destination, server name and ALPN class.
+type realityPostHandshakeEntry struct {
+	lens      atomic.Pointer[[]int]
+	nextCheck atomic.Int64
+}
+
+var realityPostHandshake sync.Map // string -> *realityPostHandshakeEntry
+
+func realityALPNClass(protocols []string) int {
+	switch {
+	case len(protocols) == 0:
+		return 0
+	case protocols[0] == "h2":
+		return 2
+	default:
+		return 1
+	}
+}
+
+func realityPostHandshakeKey(dest, serverName string, alpnClass int) string {
+	return dest + " " + serverName + " " + string(rune('0'+alpnClass))
+}
+
+// RealityPrepare starts measuring the target in the background so the first
+// authenticated client already receives matching post-handshake records.
+func RealityPrepare(config *RealityConfig) {
+	realityRefreshPostHandshake(config)
+}
+
+func realityRefreshPostHandshake(config *RealityConfig) {
+	now := time.Now().Unix()
+	for serverName := range config.ServerNames {
+		for alpnClass := 0; alpnClass < 3; alpnClass++ {
+			key := realityPostHandshakeKey(config.Dest, serverName, alpnClass)
+			value, _ := realityPostHandshake.LoadOrStore(key, new(realityPostHandshakeEntry))
+			entry := value.(*realityPostHandshakeEntry)
+			next := entry.nextCheck.Load()
+			if now < next || !entry.nextCheck.CompareAndSwap(next, now+int64(realityPostHandshakeRetry/time.Second)) {
+				continue
+			}
+			go realityMeasurePostHandshake(config, entry, serverName, alpnClass)
+		}
+	}
+}
+
+func realityMeasurePostHandshake(config *RealityConfig, entry *realityPostHandshakeEntry, serverName string, alpnClass int) {
+	ctx, cancel := context.WithTimeout(context.Background(), realityPostHandshakeDial)
+	defer cancel()
+	target, err := config.DialContext(ctx, config.Type, config.Dest)
+	if err != nil {
+		return
+	}
+	defer target.Close()
+	probe := &realityPostHandshakeConn{Conn: target}
+	var protocols []string
+	fingerprint := HelloGolang
+	switch alpnClass {
+	case 1:
+		protocols = []string{"http/1.1"}
+	case 2:
+		protocols = []string{"h2", "http/1.1"}
+		fingerprint = HelloChrome_Auto
+	}
+	client := UClient(probe, &Config{ServerName: serverName, NextProtos: protocols}, fingerprint)
+	target.SetDeadline(time.Now().Add(realityPostHandshakeDial))
+	if client.Handshake() != nil {
+		return
+	}
+	io.Copy(io.Discard, client)
+	if !probe.measured {
+		return
+	}
+	lens := probe.lens
+	entry.lens.Store(&lens)
+	entry.nextCheck.Store(time.Now().Add(realityPostHandshakeRefresh).Unix())
+}
+
+// realityPostHandshakeConn reads what the target sends once the client has
+// finished, recording only the length of each application data record.
+type realityPostHandshakeConn struct {
+	net.Conn
+	ccsSent  bool
+	measured bool
+	lens     []int
+}
+
+func (c *realityPostHandshakeConn) Write(b []byte) (int, error) {
+	if bytes.HasPrefix(b, []byte{byte(recordTypeChangeCipherSpec), 3, 3}) {
+		c.ccsSent = true
+	}
+	return c.Conn.Write(b)
+}
+
+func (c *realityPostHandshakeConn) Read(b []byte) (int, error) {
+	if !c.ccsSent {
+		return c.Conn.Read(b)
+	}
+	c.Conn.SetReadDeadline(time.Now().Add(realityPostHandshakeWait))
+	data, _ := io.ReadAll(c.Conn)
+	c.lens = realityParsePostHandshake(data)
+	c.measured = true
+	return 0, io.EOF
+}
+
+func realityParsePostHandshake(data []byte) []int {
+	var lens []int
+	for len(lens) < realityPostHandshakeMax &&
+		len(data) >= recordHeaderLen &&
+		bytes.Equal(data[:3], []byte{byte(recordTypeApplicationData), 3, 3}) {
+		length := int(binary.BigEndian.Uint16(data[3:5])) + recordHeaderLen
+		if length > len(data) || length < realityPostHandshakeMinLen {
+			break
+		}
+		lens = append(lens, length)
+		data = data[length:]
+	}
+	return lens
+}
+
+// writePostHandshakeRecords imitates the target's post-handshake flight. Each
+// record is an empty application data record padded to the measured length,
+// which TLS 1.3 clients ignore as padding.
+func (hs *realityServerHandshakeStateTLS13) writePostHandshakeRecords(dest string) error {
+	key := realityPostHandshakeKey(dest, hs.clientHello.serverName, realityALPNClass(hs.clientHello.alpnProtocols))
+	value, ok := realityPostHandshake.Load(key)
+	if !ok {
+		return nil
+	}
+	lens := value.(*realityPostHandshakeEntry).lens.Load()
+	if lens == nil {
+		return nil
+	}
+	sealer, ok := hs.c.out.cipher.(aead)
+	if !ok {
+		return nil
+	}
+	for _, length := range *lens {
+		plain := make([]byte, length-sealer.Overhead())
+		plain[0] = byte(recordTypeApplicationData)
+		plain[1], plain[2] = 3, 3
+		binary.BigEndian.PutUint16(plain[3:5], uint16(length-recordHeaderLen))
+		plain[recordHeaderLen] = byte(recordTypeApplicationData)
+		record := sealer.Seal(plain[:recordHeaderLen], hs.c.out.seq[:], plain[recordHeaderLen:], plain[:recordHeaderLen])
+		hs.c.out.incSeq()
+		if _, err := hs.c.write(record); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/reality_apsp_test.go b/reality_apsp_test.go
new file mode 100644
index 0000000..b27197c
--- /dev/null
+++ b/reality_apsp_test.go
@@ -0,0 +1,118 @@
+package tls
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"reflect"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestRealityParsePostHandshake(t *testing.T) {
+	record := func(length int) []byte {
+		return append([]byte{23, 3, 3, byte(length >> 8), byte(length)}, make([]byte, length)...)
+	}
+	data := append(record(293), record(293)...)
+	if got := realityParsePostHandshake(data); !reflect.DeepEqual(got, []int{298, 298}) {
+		t.Fatalf("unexpected lengths: %v", got)
+	}
+	if got := realityParsePostHandshake(record(293)[:100]); got != nil {
+		t.Fatalf("a truncated record must not be measured: %v", got)
+	}
+	if got := realityParsePostHandshake(record(4)); got != nil {
+		t.Fatalf("a record too short to reseal must be ignored: %v", got)
+	}
+	if got := realityParsePostHandshake(append([]byte{21, 3, 3, 0, 2, 1, 0}, record(293)...)); got != nil {
+		t.Fatalf("parsing must stop at a non application record: %v", got)
+	}
+}
+
+// startRelay runs RealityServer between a real client socket and a scripted
+// target so that close behaviour is observed on actual TCP connections.
+func startRelay(t *testing.T, target func(net.Conn)) *net.TCPConn {
+	t.Helper()
+	targetListener := listen(t)
+	go func() {
+		if conn, err := targetListener.Accept(); err == nil {
+			target(conn)
+		}
+	}()
+	inbound := listen(t)
+	config := &RealityConfig{
+		Type: "tcp",
+		Dest: targetListener.Addr().String(),
+		DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+			var dialer net.Dialer
+			return dialer.DialContext(ctx, network, address)
+		},
+		ServerNames: map[string]bool{"unused.invalid": true},
+		PrivateKey:  make([]byte, 32),
+		ShortIds:    map[[8]byte]bool{},
+	}
+	go func() {
+		if conn, err := inbound.Accept(); err == nil {
+			RealityServer(context.Background(), conn, config)
+		}
+	}()
+	conn, err := net.Dial("tcp", inbound.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	conn.SetDeadline(time.Now().Add(10 * time.Second))
+	return conn.(*net.TCPConn)
+}
+
+func listen(t *testing.T) net.Listener {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { listener.Close() })
+	return listener
+}
+
+func TestRealityRelayForwardsTargetFIN(t *testing.T) {
+	client := startRelay(t, func(target net.Conn) {
+		defer target.Close()
+		target.Read(make([]byte, 64))
+		target.Write([]byte("reply"))
+		time.Sleep(200 * time.Millisecond)
+	})
+	client.Write([]byte("GET / HTTP/1.1\r\n\r\n"))
+	data, err := io.ReadAll(client)
+	if err != nil || string(data) != "reply" {
+		t.Fatalf("expected the reply followed by a clean close, got %q, %v", data, err)
+	}
+}
+
+func TestRealityRelayForwardsTargetRST(t *testing.T) {
+	client := startRelay(t, func(target net.Conn) {
+		target.Read(make([]byte, 64))
+		target.(*net.TCPConn).SetLinger(0)
+		target.Close()
+	})
+	client.Write([]byte("GET / HTTP/1.1\r\n\r\n"))
+	if _, err := io.ReadAll(client); !errors.Is(err, syscall.ECONNRESET) {
+		t.Fatalf("expected the target's reset to reach the client, got %v", err)
+	}
+}
+
+func TestRealityRelayForwardsClientHalfClose(t *testing.T) {
+	client := startRelay(t, func(target net.Conn) {
+		defer target.Close()
+		io.ReadAll(target)
+		target.Write([]byte("late reply"))
+	})
+	client.Write([]byte("GET / HTTP/1.1\r\n\r\n"))
+	time.Sleep(100 * time.Millisecond)
+	client.CloseWrite()
+	data, err := io.ReadAll(client)
+	if err != nil || string(data) != "late reply" {
+		t.Fatalf("half-close must let the target finish replying, got %q, %v", data, err)
+	}
+}
