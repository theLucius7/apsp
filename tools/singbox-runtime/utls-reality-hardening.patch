diff --git a/reality_apsp.go b/reality_apsp.go
new file mode 100644
index 0000000..615edb2
--- /dev/null
+++ b/reality_apsp.go
@@ -0,0 +1,381 @@
+// Additions made by the Apsp runtime build. They keep a REALITY inbound
+// indistinguishable from its target at the points an active prober or a
+// passive observer can measure. Ported in behaviour from XTLS/REALITY
+// (fallback close forwarding, post-handshake record imitation); see
+// tools/singbox-runtime/README.md in the Apsp repository.
+
+package tls
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+const (
+	// realityRelayLinger bounds how long a silent client can pin a relay after
+	// the target has finished. A real server has fully closed by this point.
+	realityRelayLinger = 30 * time.Second
+
+	// After the target has finished, the target socket is polled this often
+	// for the reset a closed peer sends back for further client data.
+	realityResetPoll = 10 * time.Millisecond
+
+	// A fallback client that stops reading would otherwise pin the relay
+	// forever; each write to it must make progress within this time.
+	realityRelayWriteTimeout = 2 * time.Minute
+
+	realityPostHandshakeRefresh = 6 * time.Hour
+	realityPostHandshakeRetry   = 5 * time.Minute
+	realityPostHandshakeWait    = 5 * time.Second
+	realityPostHandshakeDial    = 10 * time.Second
+	realityPostHandshakeMax     = 8
+
+	// A sealed record is header + inner type + padding + AEAD tag.
+	realityPostHandshakeMinLen = recordHeaderLen + 1 + 16
+
+	realityUnwrapDepth = 16
+)
+
+type realityCloseWriter interface {
+	CloseWrite() error
+}
+
+type realityLinger interface {
+	SetLinger(sec int) error
+}
+
+// realityUnwrap finds the innermost connection that implements T. The
+// connections sing-box hands over are often wrappers (connection tracking,
+// traffic counters, TCP Fast Open) that do not expose half-close or linger
+// themselves, while the socket underneath does.
+func realityUnwrap[T any](conn net.Conn) (T, bool) {
+	var zero T
+	for depth := 0; conn != nil && depth < realityUnwrapDepth; depth++ {
+		if value, ok := conn.(T); ok {
+			return value, true
+		}
+		switch wrapper := conn.(type) {
+		case interface{ Upstream() any }:
+			next, ok := wrapper.Upstream().(net.Conn)
+			if !ok {
+				return zero, false
+			}
+			conn = next
+		case interface{ NetConn() net.Conn }:
+			conn = wrapper.NetConn()
+		default:
+			return zero, false
+		}
+	}
+	return zero, false
+}
+
+// realityCloseWrite forwards the end of one relayed direction. Half-close must
+// survive: the opposite direction may still be delivering the target's reply.
+func realityCloseWrite(conn net.Conn) {
+	if closer, ok := realityUnwrap[realityCloseWriter](conn); ok && closer.CloseWrite() == nil {
+		return
+	}
+	conn.Close()
+}
+
+func realityIsReset(err error) bool {
+	return errors.Is(err, syscall.ECONNRESET) || errors.Is(err, syscall.EPIPE) || realityPlatformReset(err)
+}
+
+// realityResetConn closes with a TCP reset, the way a peer that received data
+// on a closed socket answers.
+func realityResetConn(conn net.Conn) {
+	if linger, ok := realityUnwrap[realityLinger](conn); ok {
+		linger.SetLinger(0)
+	}
+	conn.Close()
+}
+
+// realityFinishClient ends the client side the way the target ended its side,
+// so close type and timing come from the target rather than from this process.
+// A reset on either side (the copy fails on whichever socket received it) is
+// passed to both.
+func realityFinishClient(client, target net.Conn, err error) {
+	if realityIsReset(err) {
+		realityResetConn(target)
+		realityResetConn(client)
+		return
+	}
+	realityCloseWrite(client)
+	client.SetReadDeadline(time.Now().Add(realityRelayLinger))
+}
+
+// realityAbortClient handles a target that ended before sending anything.
+func realityAbortClient(client net.Conn, err error) {
+	if realityIsReset(err) {
+		realityResetConn(client)
+		return
+	}
+	client.Close()
+}
+
+// realityEndTarget forwards how the client ended its direction to the target.
+func realityEndTarget(target net.Conn, err error) {
+	if err == nil || errors.Is(err, io.EOF) {
+		realityCloseWrite(target)
+		return
+	}
+	if realityIsReset(err) {
+		realityResetConn(target)
+		return
+	}
+	target.Close()
+}
+
+// realityRelayUpload copies the client's bytes to the target during fallback.
+// Unlike io.Copy it forwards how the client ended: a half-close as a half-close
+// and a reset as a reset, even when the reset was already consumed by a write on
+// the other relay direction and the read only reports EOF.
+func realityRelayUpload(target net.Conn, client io.Reader, clientConn net.Conn, targetDone *atomic.Bool) {
+	buf := make([]byte, 32*1024)
+	for {
+		n, err := client.Read(buf)
+		if n > 0 {
+			if _, writeErr := target.Write(buf[:n]); writeErr != nil {
+				if realityIsReset(writeErr) {
+					realityResetConn(clientConn)
+				}
+				target.Close()
+				return
+			}
+		}
+		if err != nil {
+			// A FIN leaves the socket in CLOSE_WAIT; reading EOF from a socket that
+			// is already closed means a reset whose error the other direction took.
+			// Once the target has finished, this side sent a FIN first and a normal
+			// close also ends in that state, so only the pending error counts then.
+			if errors.Is(err, io.EOF) {
+				if closed, reset, _ := realityConnState(clientConn); reset || (closed && !targetDone.Load()) {
+					err = syscall.ECONNRESET
+				}
+			}
+			realityEndTarget(target, err)
+			return
+		}
+	}
+}
+
+// realityConnState reports whether the socket under conn has closed and whether
+// it closed by a reset; known is false where this cannot be determined.
+func realityConnState(conn net.Conn) (closed, reset, known bool) {
+	raw, ok := realityUnwrap[syscall.Conn](conn)
+	if !ok {
+		return false, false, false
+	}
+	control, err := raw.SyscallConn()
+	if err != nil {
+		return false, false, false
+	}
+	return realitySocketState(control)
+}
+
+// realityWatchTargetReset runs once the target has finished. A closed target
+// answers further client data with a reset, which a direct client would see at
+// once; the relay passes it on without delaying the upload direction. It stops
+// when the target closes normally, when the relay ends or after the linger.
+func realityWatchTargetReset(target, client net.Conn, done <-chan struct{}) {
+	ticker := time.NewTicker(realityResetPoll)
+	defer ticker.Stop()
+	linger := time.NewTimer(realityRelayLinger)
+	defer linger.Stop()
+	for {
+		select {
+		case <-done:
+			return
+		case <-linger.C:
+			return
+		case <-ticker.C:
+			closed, reset, known := realityConnState(target)
+			switch {
+			case !known:
+				return
+			case reset:
+				realityResetConn(client)
+				return
+			case closed:
+				return
+			}
+		}
+	}
+}
+
+// realityProgressWriter bounds each fallback write to the client, so a client
+// that stops reading cannot hold the relay's goroutines and sockets forever.
+type realityProgressWriter struct{ net.Conn }
+
+func (w realityProgressWriter) Write(b []byte) (int, error) {
+	w.Conn.SetWriteDeadline(time.Now().Add(realityRelayWriteTimeout))
+	return w.Conn.Write(b)
+}
+
+// realityPostHandshakeEntry holds the record lengths a target sends right after
+// the client's Finished, for one destination, server name and ALPN class.
+type realityPostHandshakeEntry struct {
+	lens      atomic.Pointer[[]int]
+	nextCheck atomic.Int64
+}
+
+var realityPostHandshake sync.Map // string -> *realityPostHandshakeEntry
+
+func realityALPNClass(protocols []string) int {
+	switch {
+	case len(protocols) == 0:
+		return 0
+	case protocols[0] == "h2":
+		return 2
+	default:
+		return 1
+	}
+}
+
+func realityPostHandshakeKey(dest, serverName string, alpnClass int) string {
+	return dest + " " + serverName + " " + string(rune('0'+alpnClass))
+}
+
+// RealityPrepare starts measuring the target in the background so the first
+// authenticated client already receives matching post-handshake records.
+func RealityPrepare(config *RealityConfig) {
+	realityRefreshPostHandshake(config)
+}
+
+func realityRefreshPostHandshake(config *RealityConfig) {
+	now := time.Now().Unix()
+	for serverName := range config.ServerNames {
+		for alpnClass := 0; alpnClass < 3; alpnClass++ {
+			key := realityPostHandshakeKey(config.Dest, serverName, alpnClass)
+			value, _ := realityPostHandshake.LoadOrStore(key, new(realityPostHandshakeEntry))
+			entry := value.(*realityPostHandshakeEntry)
+			next := entry.nextCheck.Load()
+			if now < next || !entry.nextCheck.CompareAndSwap(next, now+int64(realityPostHandshakeRetry/time.Second)) {
+				continue
+			}
+			go realityMeasurePostHandshake(config, entry, serverName, alpnClass)
+		}
+	}
+}
+
+func realityMeasurePostHandshake(config *RealityConfig, entry *realityPostHandshakeEntry, serverName string, alpnClass int) {
+	ctx, cancel := context.WithTimeout(context.Background(), realityPostHandshakeDial)
+	defer cancel()
+	target, err := config.DialContext(ctx, config.Type, config.Dest)
+	if err != nil {
+		return
+	}
+	defer target.Close()
+	// Fast-open dialers ignore deadlines before the first write; closing the
+	// socket is the bound that always holds.
+	stop := time.AfterFunc(realityPostHandshakeDial+realityPostHandshakeWait, func() { target.Close() })
+	defer stop.Stop()
+	probe := &realityPostHandshakeConn{Conn: target}
+	var protocols []string
+	fingerprint := HelloGolang
+	switch alpnClass {
+	case 1:
+		protocols = []string{"http/1.1"}
+	case 2:
+		protocols = []string{"h2", "http/1.1"}
+		fingerprint = HelloChrome_Auto
+	}
+	// Only record lengths are measured; verifying the certificate would only
+	// make the measurement depend on the local CA store.
+	client := UClient(probe, &Config{ServerName: serverName, NextProtos: protocols, InsecureSkipVerify: true}, fingerprint)
+	target.SetDeadline(time.Now().Add(realityPostHandshakeDial))
+	if client.Handshake() != nil {
+		return
+	}
+	io.Copy(io.Discard, client)
+	if !probe.measured {
+		return
+	}
+	lens := probe.lens
+	entry.lens.Store(&lens)
+	entry.nextCheck.Store(time.Now().Add(realityPostHandshakeRefresh).Unix())
+}
+
+// realityPostHandshakeConn reads what the target sends once the client has
+// finished, recording only the length of each application data record.
+type realityPostHandshakeConn struct {
+	net.Conn
+	ccsSent  bool
+	measured bool
+	lens     []int
+}
+
+func (c *realityPostHandshakeConn) Write(b []byte) (int, error) {
+	if bytes.HasPrefix(b, []byte{byte(recordTypeChangeCipherSpec), 3, 3}) {
+		c.ccsSent = true
+	}
+	return c.Conn.Write(b)
+}
+
+func (c *realityPostHandshakeConn) Read(b []byte) (int, error) {
+	if !c.ccsSent {
+		return c.Conn.Read(b)
+	}
+	c.Conn.SetReadDeadline(time.Now().Add(realityPostHandshakeWait))
+	data, _ := io.ReadAll(c.Conn)
+	c.lens = realityParsePostHandshake(data)
+	c.measured = true
+	return 0, io.EOF
+}
+
+func realityParsePostHandshake(data []byte) []int {
+	var lens []int
+	for len(lens) < realityPostHandshakeMax &&
+		len(data) >= recordHeaderLen &&
+		bytes.Equal(data[:3], []byte{byte(recordTypeApplicationData), 3, 3}) {
+		length := int(binary.BigEndian.Uint16(data[3:5])) + recordHeaderLen
+		if length > len(data) || length < realityPostHandshakeMinLen {
+			break
+		}
+		lens = append(lens, length)
+		data = data[length:]
+	}
+	return lens
+}
+
+// writePostHandshakeRecords imitates the target's post-handshake flight. Each
+// record is an empty application data record padded to the measured length,
+// which TLS 1.3 clients ignore as padding.
+func (hs *realityServerHandshakeStateTLS13) writePostHandshakeRecords(dest string) error {
+	key := realityPostHandshakeKey(dest, hs.clientHello.serverName, realityALPNClass(hs.clientHello.alpnProtocols))
+	value, ok := realityPostHandshake.Load(key)
+	if !ok {
+		return nil
+	}
+	lens := value.(*realityPostHandshakeEntry).lens.Load()
+	if lens == nil {
+		return nil
+	}
+	sealer, ok := hs.c.out.cipher.(aead)
+	if !ok {
+		return nil
+	}
+	for _, length := range *lens {
+		plain := make([]byte, length-sealer.Overhead())
+		plain[0] = byte(recordTypeApplicationData)
+		plain[1], plain[2] = 3, 3
+		binary.BigEndian.PutUint16(plain[3:5], uint16(length-recordHeaderLen))
+		plain[recordHeaderLen] = byte(recordTypeApplicationData)
+		record := sealer.Seal(plain[:recordHeaderLen], hs.c.out.seq[:], plain[recordHeaderLen:], plain[:recordHeaderLen])
+		hs.c.out.incSeq()
+		if _, err := hs.c.write(record); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/reality_apsp_linux.go b/reality_apsp_linux.go
new file mode 100644
index 0000000..8ca655b
--- /dev/null
+++ b/reality_apsp_linux.go
@@ -0,0 +1,35 @@
+//go:build linux
+
+package tls
+
+import (
+	"encoding/binary"
+	"syscall"
+)
+
+const realityTCPClose = 7 // TCP_CLOSE in the kernel's tcp_states
+
+// realitySocketState reads the TCP state (the first byte of tcp_info) without
+// side effects; only once the socket has closed is its pending error read, to
+// tell a reset (ECONNRESET, or EPIPE in CLOSE_WAIT) from a normal close.
+func realitySocketState(control syscall.RawConn) (closed, reset, known bool) {
+	var info, pending int
+	var infoErr, pendingErr error
+	if control.Control(func(fd uintptr) {
+		info, infoErr = syscall.GetsockoptInt(int(fd), syscall.IPPROTO_TCP, syscall.TCP_INFO)
+		if infoErr != nil {
+			return
+		}
+		var raw [4]byte
+		binary.NativeEndian.PutUint32(raw[:], uint32(info))
+		if raw[0] != realityTCPClose {
+			return
+		}
+		closed = true
+		pending, pendingErr = syscall.GetsockoptInt(int(fd), syscall.SOL_SOCKET, syscall.SO_ERROR)
+	}) != nil || infoErr != nil || pendingErr != nil {
+		return false, false, false
+	}
+	errno := syscall.Errno(pending)
+	return closed, closed && (errno == syscall.ECONNRESET || errno == syscall.EPIPE), true
+}
