+//go:build unix
+
+package tls
+
+import "syscall"
+
+// realitySocketReset reads the socket's pending error. A reset received while
+// the socket waits in CLOSE_WAIT is reported as EPIPE, otherwise ECONNRESET.
+func realitySocketReset(control syscall.RawConn) (reset bool, known bool) {
+	var value int
+	var err error
+	if control.Control(func(fd uintptr) {
+		value, err = syscall.GetsockoptInt(int(fd), syscall.SOL_SOCKET, syscall.SO_ERROR)
+	}) != nil || err != nil {
+		return false, false
+	}
+	errno := syscall.Errno(value)
+	return errno == syscall.ECONNRESET || errno == syscall.EPIPE, true
+}
