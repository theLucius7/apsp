+
+func TestAPSPSharedAdmission(t *testing.T) {
+	limits, err := newAPSPLimits([]option.APSPUserLimit{{Principals: []string{"u1_n1", "u1_n2"}, MaxConnections: 3}, {Principals: []string{"u2_n1"}, MaxConnections: 1}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	var sessions []*apspSession
+	for i := 0; i < 100; i++ {
+		wg.Go(func() {
+			s, err := limits["u1_n2"].acquire(context.Background())
+			if err == nil {
+				mu.Lock()
+				sessions = append(sessions, s)
+				mu.Unlock()
+			}
+		})
+	}
+	wg.Wait()
+	if len(sessions) != 3 {
+		t.Fatalf("admitted %d", len(sessions))
+	}
+	if _, err := limits["u1_n1"].acquire(context.Background()); err == nil {
+		t.Fatal("second node escaped shared limit")
+	}
+	other, err := limits["u2_n1"].acquire(context.Background())
+	if err != nil {
+		t.Fatal("another user was blocked")
+	}
+	other.release()
+	for _, s := range sessions {
+		s.release()
+		s.release()
+	}
+	if limits["u1_n1"].active.Load() != 0 {
+		t.Fatal("double release or leaked reservation")
+	}
+	if _, err := newAPSPLimits([]option.APSPUserLimit{{Principals: []string{"x", "x"}}}); err == nil {
+		t.Fatal("duplicate identity accepted")
+	}
+}
+
+func TestAPSPBandwidthAndDeadline(t *testing.T) {
+	limits, _ := newAPSPLimits([]option.APSPUserLimit{{Principals: []string{"a", "b"}, UploadBytesPerSecond: 128 * 1024, DownloadBytesPerSecond: 128 * 1024}})
+	first, _ := limits["a"].acquire(context.Background())
+	second, _ := limits["b"].acquire(context.Background())
+	defer first.release()
+	defer second.release()
+	for _, upload := range []bool{true, false} {
+		limiter := first.limit.download
+		if upload {
+			limiter = first.limit.upload
+		}
+		start := time.Now()
+		var wg sync.WaitGroup
+		for _, s := range []*apspSession{first, second} {
+			wg.Go(func() {
+				if err := s.wait(limiter, 64*1024, upload); err != nil {
+					t.Error(err)
+				}
+			})
+		}
+		wg.Wait()
+		if time.Since(start) < 650*time.Millisecond {
+			t.Fatal("aggregate bandwidth was bypassed")
+		}
+	}
+	blocked, _ := (&apspLimit{download: newLimiterForDeadline()}).acquire(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- blocked.wait(blocked.limit.download, apspBurst*2, false) }()
+	time.Sleep(10 * time.Millisecond)
+	blocked.deadline(time.Now(), false, true)
+	select {
+	case err := <-done:
+		if !errors.Is(err, os.ErrDeadlineExceeded) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("changed deadline did not interrupt limiter")
+	}
+	blocked.release()
+}
+
+func newLimiterForDeadline() *rate.Limiter { return rate.NewLimiter(1, apspBurst) }
+
+func TestAPSPWrappersAndCancellation(t *testing.T) {
+	group := &apspLimit{maximum: 2}
+	tcpSession, _ := group.acquire(context.Background())
+	packetSession, _ := group.acquire(context.Background())
+	local, peer := net.Pipe()
+	defer peer.Close()
+	conn := &apspConn{Conn: local, session: tcpSession}
+	packet := &apspPacketConn{PacketConn: &apspPacketFixture{}, session: packetSession}
+	if _, err := group.acquire(context.Background()); err == nil {
+		t.Fatal("TCP and UDP did not share capacity")
+	}
+	payload := make([]byte, apspBurst*3)
+	go func() { _, _ = peer.Write(payload) }()
+	if _, err := io.ReadFull(conn, payload); err != nil {
+		t.Fatal(err)
+	}
+	go func() { _, _ = io.CopyN(io.Discard, peer, int64(len(payload))) }()
+	if n, err := conn.Write(payload); err != nil || n != len(payload) {
+		t.Fatalf("write %d: %v", n, err)
+	}
+	_ = conn.Close()
+	tcpSession.release()
+	_ = packet.Close()
+	packetSession.release()
+	if group.active.Load() != 0 {
+		t.Fatal("close leaked capacity")
+	}
+	s, _ := (&apspLimit{upload: newLimiterForDeadline()}).acquire(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- s.wait(s.limit.upload, apspBurst*2, true) }()
+	s.release()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("close did not interrupt limiter")
+	}
+}
+
