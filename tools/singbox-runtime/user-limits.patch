+package route
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/bufio/deadline"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"golang.org/x/time/rate"
+)
+
+const apspBurst = 32 * 1024
+
+type apspLimit struct {
+	upload, download *rate.Limiter
+	maximum          int64
+	active           atomic.Int64
+}
+
+func newAPSPLimits(options []option.APSPUserLimit) (map[string]*apspLimit, error) {
+	limits := make(map[string]*apspLimit)
+	for _, item := range options {
+		if len(item.Principals) == 0 || item.UploadBytesPerSecond > 125000000000 || item.DownloadBytesPerSecond > 125000000000 || item.MaxConnections > 1000000 {
+			return nil, fmt.Errorf("invalid APSP user limit")
+		}
+		group := &apspLimit{maximum: int64(item.MaxConnections)}
+		if item.UploadBytesPerSecond > 0 {
+			group.upload = rate.NewLimiter(rate.Limit(item.UploadBytesPerSecond), apspBurst)
+		}
+		if item.DownloadBytesPerSecond > 0 {
+			group.download = rate.NewLimiter(rate.Limit(item.DownloadBytesPerSecond), apspBurst)
+		}
+		for _, principal := range item.Principals {
+			if principal == "" || len(principal) > 256 {
+				return nil, fmt.Errorf("invalid APSP principal")
+			}
+			if _, exists := limits[principal]; exists {
+				return nil, fmt.Errorf("duplicate APSP principal")
+			}
+			limits[principal] = group
+		}
+	}
+	return limits, nil
+}
+
+func (l *apspLimit) acquire(ctx context.Context) (*apspSession, error) {
+	for {
+		active := l.active.Load()
+		if l.maximum > 0 && active >= l.maximum {
+			return nil, fmt.Errorf("APSP connection limit reached")
+		}
+		if l.active.CompareAndSwap(active, active+1) {
+			break
+		}
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	return &apspSession{ctx: ctx, cancel: cancel, limit: l, changed: make(chan struct{})}, nil
+}
+
+type apspSession struct {
+	ctx                         context.Context
+	cancel                      context.CancelFunc
+	limit                       *apspLimit
+	once                        sync.Once
+	mu                          sync.Mutex
+	readDeadline, writeDeadline time.Time
+	changed                     chan struct{}
+}
+
+func (s *apspSession) release() {
+	s.once.Do(func() { s.cancel(); s.limit.active.Add(-1) })
+}
+
+func (s *apspSession) deadline(t time.Time, read, write bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if read {
+		s.readDeadline = t
+	}
+	if write {
+		s.writeDeadline = t
+	}
+	close(s.changed)
+	s.changed = make(chan struct{})
+}
+
+// Reservations are shared by every authenticated principal in the group. A
+// deadline change or close interrupts a pending reservation, including UDP.
+func (s *apspSession) wait(limiter *rate.Limiter, size int, read bool) error {
+	if limiter == nil {
+		return nil
+	}
+	for size > 0 {
+		n := min(size, apspBurst)
+		reservation := limiter.ReserveN(time.Now(), n)
+		if !reservation.OK() {
+			return fmt.Errorf("invalid APSP bandwidth reservation")
+		}
+		ready := time.Now().Add(reservation.Delay())
+		for {
+			s.mu.Lock()
+			deadline := s.writeDeadline
+			if read {
+				deadline = s.readDeadline
+			}
+			changed := s.changed
+			s.mu.Unlock()
+			if err := s.ctx.Err(); err != nil {
+				reservation.Cancel()
+				return err
+			}
+			now := time.Now()
+			if !deadline.IsZero() && !now.Before(deadline) {
+				reservation.Cancel()
+				return os.ErrDeadlineExceeded
+			}
+			if !now.Before(ready) {
+				break
+			}
+			wake := ready
+			if !deadline.IsZero() && deadline.Before(wake) {
+				wake = deadline
+			}
+			timer := time.NewTimer(time.Until(wake))
+			select {
+			case <-s.ctx.Done():
+				timer.Stop()
+				reservation.Cancel()
+				return s.ctx.Err()
+			case <-changed:
+				timer.Stop()
+			case <-timer.C:
+			}
+		}
+		size -= n
+	}
+	return nil
+}
+
+// Embed only the minimal interfaces: exposing Upstream/ReaderReplaceable would
+// let splice and zero-copy helpers bypass enforcement. Protocol handshakes stay
+// on the original connection and authenticated payload passes through here.
+type apspConn struct {
+	net.Conn
+	session *apspSession
+}
+
+func (c *apspConn) Read(p []byte) (int, error) {
+	n, err := c.Conn.Read(p[:min(len(p), apspBurst)])
+	if waitErr := c.session.wait(c.session.limit.upload, n, true); waitErr != nil {
+		return 0, waitErr
+	}
+	return n, err
+}
+func (c *apspConn) Write(p []byte) (int, error) {
+	total := 0
+	for len(p) > 0 {
+		chunk := p[:min(len(p), apspBurst)]
+		if err := c.session.wait(c.session.limit.download, len(chunk), false); err != nil {
+			return total, err
+		}
+		n, err := c.Conn.Write(chunk)
+		total += n
+		if err != nil {
+			return total, err
+		}
+		if n != len(chunk) {
+			return total, fmt.Errorf("short APSP connection write")
+		}
+		p = p[n:]
+	}
+	return total, nil
+}
+func (c *apspConn) Close() error { c.session.release(); return c.Conn.Close() }
+func (c *apspConn) SetDeadline(t time.Time) error {
+	c.session.deadline(t, true, true)
+	return c.Conn.SetDeadline(t)
+}
+func (c *apspConn) SetReadDeadline(t time.Time) error {
+	c.session.deadline(t, true, false)
+	return c.Conn.SetReadDeadline(t)
+}
+func (c *apspConn) SetWriteDeadline(t time.Time) error {
+	c.session.deadline(t, false, true)
+	return c.Conn.SetWriteDeadline(t)
+}
+
+// Preserve the packet buffer ownership contract: WritePacket consumes it even
+// when admission waiting is cancelled before the underlying writer is called.
+type apspPacketConn struct {
+	N.PacketConn
+	session *apspSession
+}
+
+func (c *apspPacketConn) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	destination, err := c.PacketConn.ReadPacket(buffer)
+	if err == nil {
+		err = c.session.wait(c.session.limit.upload, buffer.Len(), true)
+	}
+	return destination, err
+}
+func (c *apspPacketConn) WritePacket(buffer *buf.Buffer, destination M.Socksaddr) error {
+	if err := c.session.wait(c.session.limit.download, buffer.Len(), false); err != nil {
+		buffer.Release()
+		return err
+	}
+	return c.PacketConn.WritePacket(buffer, destination)
+}
+func (c *apspPacketConn) Close() error { c.session.release(); return c.PacketConn.Close() }
+func (c *apspPacketConn) SetDeadline(t time.Time) error {
+	c.session.deadline(t, true, true)
+	return c.PacketConn.SetDeadline(t)
+}
+func (c *apspPacketConn) SetReadDeadline(t time.Time) error {
+	c.session.deadline(t, true, false)
+	return c.PacketConn.SetReadDeadline(t)
+}
+func (c *apspPacketConn) SetWriteDeadline(t time.Time) error {
+	c.session.deadline(t, false, true)
+	return c.PacketConn.SetWriteDeadline(t)
+}
+
+func (c *apspConn) ConnHandshakeSuccess(conn net.Conn) error {
+	return N.ReportConnHandshakeSuccess(c.Conn, conn)
+}
+func (c *apspConn) HandshakeFailure(err error) error { return N.ReportHandshakeFailure(c.Conn, err) }
+func (c *apspPacketConn) PacketConnHandshakeSuccess(conn net.PacketConn) error {
+	return N.ReportPacketConnHandshakeSuccess(c.PacketConn, conn)
+}
+func (c *apspPacketConn) HandshakeFailure(err error) error {
+	return N.ReportHandshakeFailure(c.PacketConn, err)
+}
+
+// Preserve protocol buffer requirements without exposing a bypassable reader.
+func (c *apspPacketConn) FrontHeadroom() int  { return N.CalculateFrontHeadroom(c.PacketConn) }
+func (c *apspPacketConn) RearHeadroom() int   { return N.CalculateRearHeadroom(c.PacketConn) }
+func (c *apspPacketConn) ReaderOverhead() int { return N.CalculateReaderOverhead(c.PacketConn) }
+func (c *apspPacketConn) ReaderMTU() int      { return N.CalculateMTU(c.PacketConn, nil) }
+func (c *apspPacketConn) WriterMTU() int      { return N.CalculateMTU(nil, c.PacketConn) }
+func (c *apspPacketConn) NeedAdditionalReadDeadline() bool {
+	return deadline.NeedAdditionalReadDeadline(c.PacketConn)
+}
+func (c *apspConn) NeedAdditionalReadDeadline() bool {
+	return deadline.NeedAdditionalReadDeadline(c.Conn)
+}
