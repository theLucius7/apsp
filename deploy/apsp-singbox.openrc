#!/sbin/openrc-run

description="Apsp 代理运行时"
supervisor="supervise-daemon"
command="/opt/apsp/plugins/sing-box/current/sing-box"
command_args="run -c /var/lib/apsp/plugins/sing-box@main/current/config.json -D /var/lib/apsp/plugins/sing-box@main/data"
command_user="apsp-singbox:apsp-singbox"
pidfile="/run/${RC_SVCNAME}.pid"
required_files="$command /var/lib/apsp/plugins/sing-box@main/current/config.json"
capabilities="^cap_net_bind_service"
no_new_privs="yes"
respawn_delay=5
respawn_max=0
retry="TERM/5/KILL/5"
umask="0027"
rc_ulimit="-c 0"
# APSP_RUNTIME_LOG_V1=memory-socket
output_logger="/opt/apsp/core/current/apsp-agent runtime-log --unit ${RC_SVCNAME}.service --stream stdout"
error_logger="/opt/apsp/core/current/apsp-agent runtime-log --unit ${RC_SVCNAME}.service --stream stderr"
extra_started_commands="reload"
description_reload="重载代理配置"

depend() {
    need net
}

start_pre() {
    /opt/apsp/core/current/apsp-agent verify-installed --binary /opt/apsp/plugins/sing-box/current/sing-box --name sing-box --format tar.gz || return 1
    /opt/apsp/core/current/apsp-agent verify-installed --binary /opt/apsp/core/current/apsp-agent --name agent --format raw || return 1
    checkpath --directory --mode 0755 --owner root:root /run/apsp /run/apsp/runtime-logs
    checkpath --directory --mode 0700 --owner apsp-singbox:apsp-singbox "/run/apsp/runtime-logs/${RC_SVCNAME}.service"
}

reload() {
    ebegin "重载代理配置"
    supervise-daemon "$RC_SVCNAME" --signal HUP
    eend $?
}
