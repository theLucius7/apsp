#!/sbin/openrc-run

description="Apsp Agent"
supervisor="supervise-daemon"
command="/opt/apsp/core/current/apsp-agent"
command_args="--config /etc/apsp/agent.toml supervise"
pidfile="/run/${RC_SVCNAME}.pid"
required_files="/etc/apsp/agent.toml"
respawn_delay=5
respawn_max=0
retry="TERM/5/KILL/5"
umask="0027"
output_log="/var/log/apsp/agent.log"
error_log="$output_log"

depend() {
    need net
}

start_pre() {
    /opt/apsp/core/current/apsp-agent verify-installed --binary /opt/apsp/core/current/apsp-agent --name agent --format raw || return 1
    checkpath --directory --mode 0750 --owner root:apsp-singbox /var/log/apsp
    checkpath --file --mode 0640 --owner root:root "$output_log"
}
